{application, internet_archive_filter, [
    {description, "em_filter example for Internet Archive"},
    {vsn, "0.2.0"},
    {registered, [internet_archive_filter_sup, internet_archive_filter_server]},
    {mod, {internet_archive_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        internet_archive_filter_sup,
        internet_archive_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/internet_archive_filter"}]}
]}.
